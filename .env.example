# Server
PORT=3000

# AI provider: auto | groq | anthropic | computed
# auto = Groq if GROQ_API_KEY set, else Anthropic, else rule-based
AI_PROVIDER=auto

# Groq — open-source models (Llama 3.3, free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic — fallback (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: CryptoPanic news (https://cryptopanic.com/developers/api/)
CRYPTOPANIC_TOKEN=
